{
  // Cloudflare Workers deployment for the POS web app.
  // Build first with:  CLOUDFLARE_BUILD=1 bun run build
  // Then deploy with:  bunx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucky-charms-pos",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Cloudflare replaces the Worker's whole variable set on every deploy, which
  // wiped values typed into the dashboard. `keep_vars` stops that: variables
  // and secrets set in the dashboard survive each deploy.
  "keep_vars": true,
  // Public values only — both are browser-visible by design. Leave them empty
  // here and set them in the dashboard, or fill them in for a fresh Worker.
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": ""
  },
  // One Worker serves the back office and both public storefront hosts.
  // Cloudflare Access rules decide which of them require a login.
  "routes": [
    { "pattern": "pos.luckycharmsdnbhd.com", "custom_domain": true },
    { "pattern": "member.luckycharmsdnbhd.com", "custom_domain": true },
    { "pattern": "redeem.luckycharmsdnbhd.com", "custom_domain": true }
  ]
  // Server-only values stay encrypted secrets, never committed here:
  //   wrangler secret put POS_SUPABASE_SERVICE_ROLE_KEY
  //   wrangler secret put SETTINGS_ENCRYPTION_KEY
  //   wrangler secret put SECURITY_ALERT_INGEST_SECRET
}