# Copy to .env and fill in. Never commit real values.

# The POS Supabase project the app reads and writes (safe, public values)
VITE_SUPABASE_EXTERNAL_URL=
VITE_SUPABASE_EXTERNAL_PUBLISHABLE_KEY=
POS_SUPABASE_URL=
POS_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Set these in the hosting provider's secret store
# (Lovable secrets / Cloudflare secrets / GitHub Actions secrets) — never here.
POS_SUPABASE_SERVICE_ROLE_KEY=
SETTINGS_ENCRYPTION_KEY=