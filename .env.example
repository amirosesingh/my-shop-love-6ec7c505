# Copy to .env.local (local dev) or set these in Cloudflare / CI secrets.
# Never commit real values.

# ---- Your Supabase project (browser-visible, safe to expose) ----
# Both must be set together, or the app refuses to start.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Same values for the server runtime (SSR, API routes, relay) ----
# On Cloudflare these two are PLAIN VARIABLES in Workers > Variables & Secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Server-only SECRETS: hosting secret store, never in a committed file ----
# On Cloudflare these are encrypted secrets. `keep_vars` in wrangler.jsonc keeps
# all four values in place across deploys.
POS_SUPABASE_SERVICE_ROLE_KEY=
SETTINGS_ENCRYPTION_KEY=
SECURITY_ALERTS_WEBHOOK_SECRET=

# The Supabase project the POS reads and writes (web deployment only).
# Terminals get theirs from activation or Settings -> Database & Cloud Connection.
VITE_POS_SUPABASE_URL=
VITE_POS_SUPABASE_ANON_KEY=
