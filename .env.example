# Copy to .env.local (local dev) or set these in Cloudflare / CI secrets.
# Never commit real values.
#
# One name per value: the canonical Supabase configuration is below.

# ---- Web runtime (Cloudflare Workers > Variables & Secrets, plain text) ----
# Used by SSR, API routes and the relay, and printed into the page so the
# browser reads the same values. Both must be set together.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Server-only SECRETS: hosting secret store, never in a committed file ----
# On Cloudflare these are encrypted secrets. `keep_vars` in wrangler.jsonc keeps
# them in place across deploys.
POS_SUPABASE_SERVICE_ROLE_KEY=
SETTINGS_ENCRYPTION_KEY=
SECURITY_ALERTS_WEBHOOK_SECRET=

# ---- Local development only (.env.local, never shipped) ----
# The dev machine's platform-managed .env already owns SUPABASE_URL, so the
# shop's own project is supplied under these POS-prefixed names during local
# development. They are stripped from Android and Windows builds.
VITE_POS_SUPABASE_URL=
VITE_POS_SUPABASE_ANON_KEY=

# Terminals (Android / Windows) get their URL and key from activation or from
# Settings -> Database & Cloud Connection on the device. Never from a build.
