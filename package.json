{
  "name": "tanstack_start_ts",
  "description": "Cross-platform point-of-sale and shop management application",
  "author": "My Shop Love",
  "private": true,
  "packageManager": "npm@11.4.2",
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "wrangler dev --config .output/server/wrangler.json",
    "lint": "eslint .",
    "logic:scan": "node scripts/logic-scan.cjs",
    "verify:merge": "node scripts/merge-readiness.cjs",
    "offline:sql": "node scripts/build-offline-sql.cjs",
    "offline:sql:check": "node scripts/build-offline-sql.cjs --check",
    "test": "vitest run",
    "format": "prettier --write .",
    "desktop:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:8080 electron .",
    "desktop:build": "node scripts/desktop-release.cjs",
    "desktop:package": "node scripts/desktop-release.cjs",
    "desktop:installer": "node scripts/desktop-release.cjs",
    "desktop:release": "node scripts/desktop-release.cjs",
    "mobile:build": "node scripts/mobile-build.cjs",
    "mobile:sync": "node scripts/mobile-build.cjs && npx cap sync android && node scripts/android-permissions.cjs",
    "mobile:release": "node scripts/mobile-build.cjs && npx cap sync android && node scripts/android-permissions.cjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/router-plugin": "^1.168.40",
    "capacitor-secure-storage-plugin": "0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "mssql": "^12.7.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "file:vendor/vite-tsconfig-paths",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "^2.23.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "version": "1.3.192",
  "build": {
    "appId": "app.lovable.pos",
    "productName": "Retail",
    "files": [
      "electron/**",
      "database/**",
      "dist-desktop/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/msnodesqlv8/**",
      "node_modules/mssql/**",
      "electron/db/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updatecms.luckycharmsdnbhd.com/pos-app/latest/",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "overrides": {
    "@vitest/mocker": "4.1.11",
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "uuid": "11.1.1",
    "@electron/get": "5.1.0",
    "@electron/asar": "4.3.0",
    "rimraf": "6.1.3",
    "lodash.isequal": "npm:fast-deep-equal@3.1.3",
    "glob": "13.0.3",
    "minimatch": "10.2.4"
  }
}
